<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.blog.blog.dao.BlogMapper">
    <insert id="insertRow"
            parameterType="BlogRequestDTO"> 
        INSERT INTO BLOG_TBL(TITLE, CONTENT, EMAIL)
        VALUES(#{title}, #{content}, #{email})
    </insert> 

    <!-- readRow --> 
    <select id="readRow"
            parameterType="java.lang.Integer"
            resultType="BlogResponseDTO">
        SELECT BLOGID, TITLE, CONTENT, EMAIL
        FROM BLOG_TBL
        WHERE BLOGID = #{blogId}
    </select>

    <!-- deleteRow --> 
    <delete id="deleteRow"
            parameterType="java.lang.Integer">
        DELETE FROM BLOG_TBL
        WHERE BLOGID = #{blogId}
    </delete>
</mapper>