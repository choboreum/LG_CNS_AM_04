<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.blog.blog.dao.BlogMapper">
    <insert id="insertRow"
            parameterType="com.example.blog.blog.domain.dto.BlogRequestDTO"> 
        INSERT INTO BLOG_TBL(TITLE, CONTENT, EMAIL)
        VALUES(#{title}, #{content}, #{email})
    </insert> 
</mapper>