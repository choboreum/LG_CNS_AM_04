<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.blog.comment.dao.CommentMapper">

    <!-- insertRow --> 
    <insert id="insertRow"
            parameterType="CommentRequestDTO"
            useGeneratedKeys="true"
            keyProperty="commentId">
        INSERT INTO COMMENT_TBL(CONTENT, BLOGID)
        VALUES(#{content}, #{blogId})
    </insert>    

    <!-- listRow --> 
    <select id="listRow" 
            parameterType="java.lang.Integer"
            resultType="CommentResponseDTO">
        SELECT COMMENTID, CONTENT, BLOGID 
        FROM COMMENT_TBL
        WHERE BLOGID = #{blogId}
        ORDER BY COMMENTID DESC
    </select>

    <!-- deleteRow --> 

    <delete id="deleteRow"
            parameterType="java.lang.Integer">
        DELETE FROM COMMENT_TBL
        WHERE COMMENTID = #{commentId}
    </delete>
</mapper>